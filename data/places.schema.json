{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "places.schema.json",
  "title": "PlacesData",
  "type": "object",
  "required": [
    "districts",
    "venues",
    "rooms"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "venues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "district_id",
          "name",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "district_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "building",
              "stage",
              "outdoor",
              "food_stall_area"
            ]
          }
        }
      }
    },
    "rooms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "venue_id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "venue_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "floor": {
            "type": "integer"
          }
        }
      }
    }
  }
}
